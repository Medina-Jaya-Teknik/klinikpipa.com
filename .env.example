# 1. URL Website Utama
SITE_URL="https://klinikpipa.com"

# 2. Telegram Bot (Untuk menerima laporan mingguan di HP)
# - Dapatkan token dari @BotFather di Telegram
# - Dapatkan Chat ID Anda via bot @userinfobot di Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# 3. Google Search Console API (Opsional untuk Query Mining Otomatis)
# - Buat Service Account di Google Cloud Console -> Aktifkan Google Search Console API
# - Tambahkan email Service Account sebagai 'Full' / 'Owner' di Google Search Console
GSC_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GSC_SITE_URL="sc-domain:klinikpipa.com"

# 4. Google PageSpeed API Key (Opsional, gratis dari Google Cloud)
PAGESPEED_API_KEY=""
